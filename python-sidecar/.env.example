# Server config
HOST=localhost
PORT=14201
API_V1_STR=/api/v1
PROJECT_NAME="Bridge Research AI"

# Database
DATABASE_URL="sqlite:///bridge_data.bridge"

# Logging Config
LOGGING_LEVEL=INFO
LOGGING_HANDLER=both # Use console/file/both
LOGGING_FILE_DIR=~/.bridge_research/logs

# ArXiv API Config
ARXIV_MAX_WAIT_TIME_SECONDS=3.5

# ArXiv HTTP Client Config
ARXIV_HTTP_TIMEOUT_SECONDS=30.0
ARXIV_HTTP_MAX_CONNECTIONS=10
ARXIV_HTTP_MAX_KEEPALIVE_CONNECTIONS=5

# WATCHDOG Config
WATCHDOG_TIMEOUT_SECONDS=45
WATCHDOG_CHECK_INTERVAL_SECONDS=5.0